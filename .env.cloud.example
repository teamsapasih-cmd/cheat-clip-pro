# Example only. Set real values in Railway Variables, never in this file or Git.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Cloudflare R2 (private bucket)
OBJECT_STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=clipstudio-private-media
OBJECT_STORAGE_ACCESS_KEY=SET_IN_RAILWAY_VARIABLES
OBJECT_STORAGE_SECRET_KEY=SET_IN_RAILWAY_VARIABLES

# App/auth/provider
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
GEMINI_API_KEY=SET_IN_RAILWAY_VARIABLES
CLOUD_REQUIRE_INFRASTRUCTURE=1
MAX_CLOUD_UPLOAD_BYTES=2147483648
SOURCE_MEDIA_RETENTION_DAYS=7
EXPORT_RETENTION_DAYS=7
RETENTION_SWEEP_INTERVAL_SECONDS=900
