# Local-only development configuration
# Copy this file to .env in the repository root.
# Never commit the real .env file or paste secret values into chat.

AI_PROVIDER=gemini
GEMINI_API_KEY=

# Local dev server binds to loopback; Redis-backed request limits are disabled
# by scripts/dev.js unless AUTH_RATE_LIMIT_ENABLED is explicitly set.
AUTH_RATE_LIMIT_ENABLED=false
